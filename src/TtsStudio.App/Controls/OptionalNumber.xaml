<UserControl x:Class="TtsStudio.App.Controls.OptionalNumber"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,3,0,7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CheckBox x:Name="Check" VerticalAlignment="Center" Click="OnCheckClick" />
        <TextBlock x:Name="PlainLabel" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" Visibility="Collapsed" />

        <TextBox x:Name="Box" Grid.Column="1" Width="62" Padding="6,3" FontSize="12" HorizontalContentAlignment="Right"
                 LostKeyboardFocus="OnBoxLostFocus" KeyDown="OnBoxKeyDown" GotKeyboardFocus="OnBoxGotFocus" />
        <TextBlock x:Name="UnitText" Grid.Column="2" Width="24" Margin="6,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFaintBrush}" FontSize="12" />

        <Slider x:Name="SliderCtl" Grid.Row="1" Grid.ColumnSpan="3" Margin="24,5,0,0" ValueChanged="OnSliderChanged" />
    </Grid>
</UserControl>
