<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>TtsStudio.App</RootNamespace>
    <AssemblyName>TtsStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Built from Assets/AppIcon.svg (32 px and up) and Assets/AppIcon-small.svg (16-24 px). -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TtsStudio.Core\TtsStudio.Core.csproj" />
    <!-- Ship the MCP server next to the app so users can point their coding agent at it. -->
    <ProjectReference Include="..\TtsStudio.Mcp\TtsStudio.Mcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
