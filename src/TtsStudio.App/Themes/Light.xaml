<!-- Light palette. Dark.xaml must define the same keys; ThemeManager swaps one for the other. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ surfaces -->
    <SolidColorBrush x:Key="BgBrush" Color="#ECEDF0" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FAFAFB" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#F1F2F4" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E6E8EC" />
    <SolidColorBrush x:Key="PressedBrush" Color="#DADDE3" />
    <SolidColorBrush x:Key="ToolTipBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E0E2E7" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#C9CDD5" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#A3A9B4" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C3C7CF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A3A8B2" />

    <!-- ============================================================ text and accents -->
    <SolidColorBrush x:Key="TextBrush" Color="#1B1D22" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#535A66" />
    <SolidColorBrush x:Key="TextFaintBrush" Color="#828894" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4A67EE" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5C77F3" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3A55D8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#264A67EE" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#D63B3B" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E9A5E" />
    <SolidColorBrush x:Key="WarningBrush" Color="#C7860E" />

    <!-- ============================================================ designer and pitch view -->
    <SolidColorBrush x:Key="PhonemeBrush" Color="#6B717C" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#404A67EE" />
    <SolidColorBrush x:Key="PlayHighlightBrush" Color="#22000000" />
    <SolidColorBrush x:Key="MarkerBrush" Color="#1B1D22" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#E3E5E9" />
    <SolidColorBrush x:Key="WordLineBrush" Color="#D8DBE0" />
    <SolidColorBrush x:Key="WaveBrush" Color="#45707888" />
    <SolidColorBrush x:Key="PredictedPitchBrush" Color="#8E949E" />
    <SolidColorBrush x:Key="ReferencePitchBrush" Color="#0F9488" />

</ResourceDictionary>
